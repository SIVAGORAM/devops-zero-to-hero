# This is an EXAMPLE environment file. 
# In a real project, you copy this file, rename it to '.env', and fill in your actual secrets.
# You NEVER commit the real '.env' file to Git!

# Environment configuration
ENVIRONMENT=dev
AWS_REGION=us-west-2

# Secrets (Fill these in locally)
DB_USERNAME=admin
DB_PASSWORD=your_super_secret_password_here
